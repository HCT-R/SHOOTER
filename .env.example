PORT=3000
HOST=0.0.0.0
# Public application ID and server-only OAuth client secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Set to 1 for a Discord-only deployment; 0 enables anonymous browser sessions.
REQUIRE_DISCORD_AUTH=0
# Deployment safety capacity, not an FFA rules limit. Increase after load testing.
ROOM_CAPACITY=32
MAX_ROOMS=100
# npm run deploy (DEPLOY.md): SSH target and the domain whose A record points at it.
DEPLOY_HOST=
DEPLOY_DOMAIN=
# Optional: a folder the deploy replaces on every run, and ssh with extra flags.
# DEPLOY_PATH=pixel-protocol
# DEPLOY_SSH=ssh -p 2222
